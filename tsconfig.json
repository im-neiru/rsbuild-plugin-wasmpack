{
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"target": "ES2020",
		"lib": ["DOM", "ESNext"],
		"module": "Node16",
		"strict": true,
		"declaration": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"moduleResolution": "Node16",
		"types": ["node"]
	},
	"include": ["src"]
}
