{
	"name": "rsbuild-plugin-wasmpack",
	"version": "2.3.0",
	"description": "A plugin for rsbuild to compile Rust crates to WebAssembly using wasm-pack",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/im-neiru/rsbuild-plugin-wasmpack.git"
	},
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rslib build",
		"test": "bunx playwright test test/single-crate/index.test.ts",
		"format": "biome format --write",
		"lint": "biome lint --error-on-warnings",
		"fix": "biome lint --write",
		"fix-unsafe": "biome lint --write --unsafe"
	},
	"keywords": [
		"wasm",
		"rsbuild",
		"wasm-pack",
		"rspack",
		"rust"
	],
	"author": "im-neiru",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@playwright/test": "^1.65.0",
		"@rsbuild/core": "^2.3.1",
		"@rslib/core": "^1.0.6",
		"@types/node": "^26.6.6",
		"playwright": "^1.65.0"
	},
	"dependencies": {
		"chokidar": "^6.0.0",
		"comment-json": "^5.0.0",
		"execa": "^10.2.1",
		"js-toml": "^2.0.1",
		"typescript": "^7.0.2",
		"wabt": "^1.0.39"
	},
	"peerDependencies": {
		"@rsbuild/core": "^2.3.1"
	},
	"peerDependenciesMeta": {
		"@rsbuild/core": {
			"optional": true
		}
	},
	"packageManager": "bun@1.3.14",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
